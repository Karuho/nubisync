[Unit]
Description=NubiSync ReceiveOnly synchronization daemon
Documentation=https://github.com/Karuho/nubisync
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/nubisyncd run
Restart=on-failure
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=75s
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
